# ================================================================
# VITARA — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# ================================================================

# ─── Base de données PostgreSQL ────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/vitara_db

# ─── JWT ───────────────────────────────────────────────────────
JWT_SECRET=vitara-secret-change-this-in-production-min-32-chars
JWT_REFRESH_SECRET=vitara-refresh-secret-change-this-in-prod-min-32

# ─── OpenAI (Agent IA conversationnel + résumés) ───────────────
OPENAI_API_KEY=sk-...

# ─── ElevenLabs (TTS voix IA) ─────────────────────────────────
ELEVENLABS_API_KEY=...
ELEVENLABS_VOICE_ID=...

# ─── Twilio (Téléphonie) ───────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_FROM_NUMBER=+15145550100

# ─── Deepgram (STT alternatif) ─────────────────────────────────
DEEPGRAM_API_KEY=...

# ─── SendGrid (Email) ──────────────────────────────────────────
SENDGRID_API_KEY=SG....
EMAIL_FROM=noreply@vitara.ca

# ─── App ───────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://vitara.vercel.app
NODE_ENV=development
